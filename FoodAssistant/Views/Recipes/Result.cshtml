@model FoodAssistant.DTOs.Recipes.GeneratedRecipeDto

@{
    ViewData["Title"] = "Генерирана рецепта";
}

<div class="recipe-result-page">

    <!-- BACK BUTTON -->
    <div class="result-navigation">
        <a asp-controller="Recipes"
           asp-action="Index"
           class="result-back-link">
            ← Нова рецепта
        </a>
    </div>

    <!-- RECIPE HEADER -->
    <section class="result-hero">

        <div class="result-hero-content">

            <span class="result-eyebrow">
                ✨ ТВОЯТА AI РЕЦЕПТА
            </span>

            <h1>@Model.Name</h1>

            <p class="result-description">
                @Model.Description
            </p>

            <div class="result-meta">

                <div class="result-meta-item">
                    <span>⏱️</span>
                    <span>
                        @Model.PreparationTimeMinutes минути
                    </span>
                </div>

                <div class="result-meta-item">
                    <span>👥</span>
                    <span>
                        @ViewBag.Servings порции
                    </span>
                </div>

                <div class="result-meta-item">
                    <span>🔥</span>
                    <span>
                        @Model.Nutrition.CaloriesPerServing.ToString("0.##") kcal / порция
                    </span>
                </div>

            </div>

        </div>

        <div class="result-calorie-highlight">

            <span>КАЛОРИИ</span>

            <strong>
                @Model.Nutrition.CaloriesPerServing.ToString("0.##")
            </strong>

            <small>kcal / порция</small>

        </div>

    </section>

    <!-- NUTRITION SECTION -->
    <section class="result-section">

        <div class="result-section-heading">

            <div>

                <h2>Хранителни стойности</h2>

            </div>

            <span class="section-decoration">📊</span>

        </div>

        <!-- PER SERVING -->
        <div class="nutrition-heading">
            <span>За една порция</span>
            <span class="nutrition-heading-line"></span>
        </div>

        <div class="row g-3 mb-4">

            <div class="col-6 col-lg-3">
                <div class="nutrition-card nutrition-calories">
                    <div class="nutrition-icon">🔥</div>

                    <span>Калории</span>

                    <strong>
                        @Model.Nutrition.CaloriesPerServing.ToString("0.##")
                    </strong>

                    <small>kcal</small>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="nutrition-card nutrition-protein">
                    <div class="nutrition-icon">💪</div>

                    <span>Протеини</span>

                    <strong>
                        @Model.Nutrition.ProteinPerServing.ToString("0.##")
                    </strong>

                    <small>грамa</small>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="nutrition-card nutrition-carbs">
                    <div class="nutrition-icon">🌾</div>

                    <span>Въглехидрати</span>

                    <strong>
                        @Model.Nutrition.CarbsPerServing.ToString("0.##")
                    </strong>

                    <small>грама</small>
                </div>
            </div>

            <div class="col-6 col-lg-3">
                <div class="nutrition-card nutrition-fat">
                    <div class="nutrition-icon">🥑</div>

                    <span>Мазнини</span>

                    <strong>
                        @Model.Nutrition.FatPerServing.ToString("0.##")
                    </strong>

                    <small>грама</small>
                </div>
            </div>

        </div>

        <!-- TOTAL RECIPE -->
        <div class="nutrition-total-card">

            <div>
                <span class="nutrition-total-title">
                    Общо за цялата рецепта
                </span>

                <small>
                    Хранителни стойности за всички @ViewBag.Servings порции
                </small>
            </div>

            <div class="nutrition-total-values">

                <div>
                    <strong>
                        @Model.Nutrition.TotalCalories.ToString("0.##")
                    </strong>
                    <small>kcal</small>
                </div>

                <div>
                    <strong>
                        @Model.Nutrition.TotalProtein.ToString("0.##")
                    </strong>
                    <small>Протеини</small>
                </div>

                <div>
                    <strong>
                        @Model.Nutrition.TotalCarbs.ToString("0.##")
                    </strong>
                    <small>Въглехидрати</small>
                </div>

                <div>
                    <strong>
                        @Model.Nutrition.TotalFat.ToString("0.##")
                    </strong>
                    <small>Мазнини</small>
                </div>

            </div>

        </div>

    </section>

    <!-- INGREDIENTS AND INSTRUCTIONS -->
    <div class="row g-4 result-main-content">

        <!-- INGREDIENTS -->
        <div class="col-lg-5">

            <section class="result-content-card h-100">

                <div class="result-section-heading">

                    <div>

                        <h2>Необходими продукти</h2>

                        <p>
                            Количества за цялата рецепта.
                        </p>
                    </div>

                </div>

                <div class="ingredient-list">

                    @foreach (var ingredient in Model.Ingredients)
                    {
                        <div class="ingredient-item">

                            <div class="ingredient-check">
                                ✓
                            </div>

                            <span class="ingredient-name">
                                @ingredient.Name
                            </span>

                            <strong class="ingredient-quantity">
                                @ingredient.Quantity.ToString("0.##")
                                @ingredient.Unit
                            </strong>

                        </div>
                    }

                </div>

            </section>

        </div>

        <!-- INSTRUCTIONS -->
        <div class="col-lg-7">

            <section class="result-content-card h-100">

                <div class="result-section-heading">

                    <div>

                        <h2>Начин на приготвяне</h2>

                        <p>
                            Следвай последователността на стъпките.
                        </p>
                    </div>

                </div>

                <div class="instruction-list">

                    @{
                        int stepNumber = 1;
                    }

                    @foreach (var instruction in Model.Instructions)
                    {
                        <div class="instruction-item">

                            <div class="instruction-number">
                                @stepNumber.ToString("00")
                            </div>

                            <p>
                                @instruction
                            </p>

                        </div>

                        stepNumber++;
                    }

                </div>

            </section>

        </div>

    </div>

    <!-- HEALTHY ALTERNATIVES -->
    <section class="result-section alternatives-section">

        <div class="result-section-heading">

            <div>

                <h2>Здравословни алтернативи</h2>

                <p>
                    Замени някои от продуктите с предложените алтернативи.
                </p>
            </div>

            <span class="section-decoration">🌿</span>

        </div>

        @if (Model.HealthyAlternatives.Count > 0)
        {
            <div class="row g-3">

                @for (int i = 0; i < Model.HealthyAlternatives.Count; i++)
                {
                    var alternative = Model.HealthyAlternatives[i];

                    <div class="col-md-6 col-lg-4">

                        <div class="alternative-card">

                            <div class="alternative-label">
                                ПРЕДЛОЖЕНА ЗАМЯНА
                            </div>

                            <div class="alternative-products">

                                <div class="alternative-product">
                                    <small>Оригинален продукт</small>

                                    <strong>
                                        @alternative.OriginalIngredientName
                                    </strong>
                                </div>

                                <div class="alternative-arrow">
                                    →
                                </div>

                                <div class="alternative-product alternative-new">
                                    <small>Здравословна алтернатива</small>

                                    <strong>
                                        @alternative.AlternativeName
                                    </strong>
                                </div>

                            </div>

                            <div class="alternative-quantity">
                                Количество:
                                <strong>
                                    @alternative.QuantityGrams.ToString("0.##") г.
                                </strong>
                            </div>

                            <p class="alternative-reason">
                                @alternative.Reason
                            </p>

                            <form asp-controller="Recipes"
                                  asp-action="ReplaceIngredient"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="servings"
                                       value="@ViewBag.Servings" />

                                <input type="hidden"
                                       name="sourceIngredients"
                                       value="@ViewBag.Ingredients" />

                                <input type="hidden"
                                       name="targetCalories"
                                       value="@ViewBag.TargetCalories" />

                                <input type="hidden"
                                       name="alternative.OriginalIngredientName"
                                       value="@alternative.OriginalIngredientName" />

                                <input type="hidden"
                                       name="alternative.AlternativeName"
                                       value="@alternative.AlternativeName" />

                                <input type="hidden"
                                       name="alternative.UsdaSearchTerm"
                                       value="@alternative.UsdaSearchTerm" />

                                <input type="hidden"
                                       name="alternative.QuantityGrams"
                                       value="@alternative.QuantityGrams" />

                                <input type="hidden"
                                       name="alternative.Reason"
                                       value="@alternative.Reason" />

                                <input type="hidden"
                                       name="recipe.Name"
                                       value="@Model.Name" />

                                <input type="hidden"
                                       name="recipe.Description"
                                       value="@Model.Description" />

                                <input type="hidden"
                                       name="recipe.PreparationTimeMinutes"
                                       value="@Model.PreparationTimeMinutes" />

                                @for (int j = 0; j < Model.Ingredients.Count; j++)
                                {
                                    <input type="hidden"
                                           name="recipe.Ingredients[@j].Name"
                                           value="@Model.Ingredients[j].Name" />

                                    <input type="hidden"
                                           name="recipe.Ingredients[@j].UsdaSearchTerm"
                                           value="@Model.Ingredients[j].UsdaSearchTerm" />

                                    <input type="hidden"
                                           name="recipe.Ingredients[@j].Quantity"
                                           value="@Model.Ingredients[j].Quantity" />

                                    <input type="hidden"
                                           name="recipe.Ingredients[@j].Unit"
                                           value="@Model.Ingredients[j].Unit" />
                                }

                                @for (int j = 0; j < Model.Instructions.Count; j++)
                                {
                                    <input type="hidden"
                                           name="recipe.Instructions[@j]"
                                           value="@Model.Instructions[j]" />
                                }

                                @for (int j = 0; j < Model.HealthyAlternatives.Count; j++)
                                {
                                    <input type="hidden"
                                           name="recipe.HealthyAlternatives[@j].OriginalIngredientName"
                                           value="@Model.HealthyAlternatives[j].OriginalIngredientName" />

                                    <input type="hidden"
                                           name="recipe.HealthyAlternatives[@j].AlternativeName"
                                           value="@Model.HealthyAlternatives[j].AlternativeName" />

                                    <input type="hidden"
                                           name="recipe.HealthyAlternatives[@j].UsdaSearchTerm"
                                           value="@Model.HealthyAlternatives[j].UsdaSearchTerm" />

                                    <input type="hidden"
                                           name="recipe.HealthyAlternatives[@j].QuantityGrams"
                                           value="@Model.HealthyAlternatives[j].QuantityGrams" />

                                    <input type="hidden"
                                           name="recipe.HealthyAlternatives[@j].Reason"
                                           value="@Model.HealthyAlternatives[j].Reason" />
                                }

                                <button type="submit"
                                        class="btn btn-outline-success alternative-button">
                                    Замени продукта →
                                </button>

                            </form>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="no-alternatives">
                <span>🌱</span>
                <h5>Няма предложени алтернативи</h5>
                <p>
                    За тази рецепта не са намерени подходящи замени.
                </p>
            </div>
        }

    </section>

    <!-- ACTIONS -->
    <section class="result-actions">

        <div class="result-actions-heading">
            <h2>Какво следва?</h2>

            <p>
                Запази рецептата или създай ново предложение.
            </p>
        </div>

        <div class="result-action-buttons">

            <!-- NEW RECIPE -->
            <a asp-controller="Recipes"
               asp-action="Index"
               class="btn btn-outline-secondary result-action-button">
                ← Нова рецепта
            </a>

            <!-- GENERATE ANOTHER -->
            <form asp-controller="Recipes"
                  asp-action="Generate"
                  method="post">

                <input type="hidden"
                       name="Ingredients"
                       value="@ViewBag.Ingredients" />

                <input type="hidden"
                       name="TargetCalories"
                       value="@ViewBag.TargetCalories" />

                <input type="hidden"
                       name="Servings"
                       value="@ViewBag.Servings" />

                <button type="submit"
                        class="btn btn-outline-primary result-action-button">
                    ↻ Генерирай друга
                </button>

            </form>

            <!-- SAVE RECIPE -->
            <form asp-controller="Recipes"
                  asp-action="Save"
                  method="post">

                <input type="hidden"
                       name="servings"
                       value="@ViewBag.Servings" />

                <input type="hidden"
                       name="targetCalories"
                       value="@ViewBag.TargetCalories" />

                <input type="hidden"
                       name="recipe.Name"
                       value="@Model.Name" />

                <input type="hidden"
                       name="recipe.Description"
                       value="@Model.Description" />

                <input type="hidden"
                       name="recipe.PreparationTimeMinutes"
                       value="@Model.PreparationTimeMinutes" />

                @for (int i = 0; i < Model.Instructions.Count; i++)
                {
                    <input type="hidden"
                           name="recipe.Instructions[@i]"
                           value="@Model.Instructions[i]" />
                }

                @for (int i = 0; i < Model.Ingredients.Count; i++)
                {
                    <input type="hidden"
                           name="recipe.Ingredients[@i].Name"
                           value="@Model.Ingredients[i].Name" />

                    <input type="hidden"
                           name="recipe.Ingredients[@i].UsdaSearchTerm"
                           value="@Model.Ingredients[i].UsdaSearchTerm" />

                    <input type="hidden"
                           name="recipe.Ingredients[@i].Quantity"
                           value="@Model.Ingredients[i].Quantity" />

                    <input type="hidden"
                           name="recipe.Ingredients[@i].Unit"
                           value="@Model.Ingredients[i].Unit" />
                }

                @for (int i = 0; i < Model.HealthyAlternatives.Count; i++)
                {
                    <input type="hidden"
                           name="recipe.HealthyAlternatives[@i].OriginalIngredientName"
                           value="@Model.HealthyAlternatives[i].OriginalIngredientName" />

                    <input type="hidden"
                           name="recipe.HealthyAlternatives[@i].AlternativeName"
                           value="@Model.HealthyAlternatives[i].AlternativeName" />

                    <input type="hidden"
                           name="recipe.HealthyAlternatives[@i].UsdaSearchTerm"
                           value="@Model.HealthyAlternatives[i].UsdaSearchTerm" />

                    <input type="hidden"
                           name="recipe.HealthyAlternatives[@i].QuantityGrams"
                           value="@Model.HealthyAlternatives[i].QuantityGrams" />

                    <input type="hidden"
                           name="recipe.HealthyAlternatives[@i].Reason"
                           value="@Model.HealthyAlternatives[i].Reason" />
                }

                <input type="hidden"
                       name="recipe.Nutrition.TotalCalories"
                       value="@Model.Nutrition.TotalCalories" />

                <input type="hidden"
                       name="recipe.Nutrition.TotalProtein"
                       value="@Model.Nutrition.TotalProtein" />

                <input type="hidden"
                       name="recipe.Nutrition.TotalCarbs"
                       value="@Model.Nutrition.TotalCarbs" />

                <input type="hidden"
                       name="recipe.Nutrition.TotalFat"
                       value="@Model.Nutrition.TotalFat" />

                <input type="hidden"
                       name="recipe.Nutrition.CaloriesPerServing"
                       value="@Model.Nutrition.CaloriesPerServing" />

                <input type="hidden"
                       name="recipe.Nutrition.ProteinPerServing"
                       value="@Model.Nutrition.ProteinPerServing" />

                <input type="hidden"
                       name="recipe.Nutrition.CarbsPerServing"
                       value="@Model.Nutrition.CarbsPerServing" />

                <input type="hidden"
                       name="recipe.Nutrition.FatPerServing"
                       value="@Model.Nutrition.FatPerServing" />

                <button type="submit"
                        class="btn btn-primary result-save-button">
                    ♡ Запази рецептата
                </button>

            </form>

        </div>

    </section>

</div>