@model FoodAssistant.ViewModels.RecipeGeneratorViewModel

@{
    ViewData["Title"] = "Генериране на рецепта";
}

<div class="generator-page">

    <!-- Заглавна част -->
    <div class="generator-heading">

        <h1>Създай своята следваща рецепта</h1>

        <p>
            Кажи ни с какви продукти разполагаш и какви са
            твоите предпочитания. FoodAssistant ще ти предложи
            идея за вкусно и балансирано ястие.
        </p>

    </div>

    <!-- Форма -->
    <div class="generator-card">

        <div class="generator-card-heading">

            <div>
                <span class="generator-step">НАСТРОЙ СВОЯТА РЕЦЕПТА</span>
                <h3>Какво ще сготвим днес?</h3>
                <p>Попълни полетата по-долу, за да започнем.</p>
            </div>

        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <strong>Възникна проблем:</strong>
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Recipes"
              asp-action="Generate"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Продукти -->
            <div class="generator-field mb-4">

                <label asp-for="Ingredients" class="form-label">
                    Налични продукти
                    <span class="required-label">*</span>
                </label>

                <p class="field-description">
                    Напиши продуктите, които имаш в кухнята.
                    Можеш да разделяш имената със запетаи.
                </p>

                <textarea asp-for="Ingredients"
                          class="form-control ingredients-input"
                          rows="5"
                          placeholder="Например: пилешко месо, ориз, домати, лук, моркови...">
                </textarea>

                <span asp-validation-for="Ingredients"
                      class="text-danger">
                </span>

                <div class="input-hint">
                    <span>💡</span>
                    Използвай конкретни имена на продуктите за по-добри резултати.
                </div>

            </div>

            <div class="generator-divider"></div>

            <!-- Параметри -->
            <div class="generator-field mb-4">

                <h5 class="parameters-title">
                    Настройки на рецептата
                </h5>

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="TargetCalories"
                               class="form-label">

                            <span class="field-icon">🔥</span>
                            Калории на порция
                        </label>

                        <div class="input-with-unit">

                            <input asp-for="TargetCalories"
                                   type="number"
                                   class="form-control"
                                   placeholder="Например: 500" />

                            <span class="input-unit">kcal</span>

                        </div>

                        <span asp-validation-for="TargetCalories"
                              class="text-danger">
                        </span>

                        <small class="parameter-help">
                            Желаните калории за една порция.
                        </small>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Servings"
                               class="form-label">

                            <span class="field-icon">👥</span>
                            Брой порции
                        </label>

                        <div class="input-with-unit">

                            <input asp-for="Servings"
                                   type="number"
                                   class="form-control"
                                   placeholder="Например: 2" />

                            <span class="input-unit">порции</span>

                        </div>

                        <span asp-validation-for="Servings"
                              class="text-danger">
                        </span>

                        <small class="parameter-help">
                            За колко души да бъде рецептата.
                        </small>

                    </div>

                </div>

            </div>

            <!-- Бутон -->
            <div class="generator-submit-area">

                <button type="submit"
                        class="btn btn-primary generator-submit-button">

                    <span>✨</span>
                    Генерирай рецепта
                    <span class="submit-arrow">→</span>

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}